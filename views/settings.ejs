<%- include('partials/head') %>
<%
  const slotTimes = settings.schedules.map((expr) => {
    const [m, h] = expr.split(' ');
    return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
  });
%>

<header class="page-head">
  <div>
    <div class="eyebrow">System · pipeline configuration</div>
    <h1>Settings</h1>
    <p class="sub">Posting cadence, timezone, and the base AI prompt. Everything here is stored in the SQLite <code>settings</code> table.</p>
  </div>
</header>

<div class="grid-2">
  <div class="stack">
    <section class="card">
      <div class="card-head">
        <h2>Posting cadence</h2>
        <span class="hint"><%= settings.schedules.length ? settings.schedules.length + ' slots / day' : 'scheduler off' %></span>
      </div>
      <div class="card-body">
        <div class="form-grid cols-2">
          <label class="field">
            <span class="lbl">Videos per day</span>
            <input class="input" type="number" id="set_vpd" min="0" max="24" value="<%= config.videos_per_day %>">
            <span class="help">0 disables the scheduler.</span>
          </label>
          <label class="field">
            <span class="lbl">Timezone</span>
            <input class="input" type="text" id="set_tz" value="<%= config.tz %>" list="tzList" placeholder="America/New_York">
            <span class="help">IANA timezone used by cron.</span>
          </label>
          <label class="field">
            <span class="lbl">Window start</span>
            <input class="input" type="time" id="set_ws" value="<%= config.window_start %>">
          </label>
          <label class="field">
            <span class="lbl">Window end</span>
            <input class="input" type="time" id="set_we" value="<%= config.window_end %>">
          </label>
        </div>

        <div class="row mt-14" style="gap:8px">
          <span class="faint small">Slots:</span>
          <% if (slotTimes.length) { %>
            <% slotTimes.forEach((t) => { %><span class="chip mono"><%= t %></span><% }) %>
          <% } else { %>
            <span class="badge warn">No scheduled runs</span>
          <% } %>
        </div>

        <div class="form-actions mt-14">
          <button class="btn btn-primary" id="saveCadence" onclick="saveCadence()">Save cadence</button>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>Base AI prompt</h2>
        <span class="hint"><%= config.ai_base_prompt.length %> chars · <%= aiModel || 'default model' %></span>
      </div>
      <div class="card-body">
        <p class="small muted" style="margin-bottom:12px;line-height:1.6">
          Used by every generation. The per-account category prompt is the specific brief; this base prompt holds the
          global voice, safety rules and formatting expectations. The JSON output contract is appended automatically.
        </p>
        <label class="field">
          <span class="lbl">Prompt text</span>
          <textarea class="textarea mono" id="set_prompt" style="min-height:300px"><%= config.ai_base_prompt %></textarea>
          <span class="help">Saving an empty value falls back to the built-in default at generation time.</span>
        </label>
        <div class="form-actions">
          <button class="btn btn-primary" id="savePrompt" onclick="saveBasePrompt()">Save base prompt</button>
          <a class="btn" href="/categories">Per-category prompts</a>
        </div>
      </div>
    </section>
  </div>

  <div class="stack">
    <section class="card">
      <div class="card-head">
        <h2>Rotation</h2>
        <span class="hint">advances after a successful post</span>
      </div>
      <div class="card-body">
        <% if (!next) { %>
          <div class="empty" style="padding:12px 0">
            <div class="empty-title">Nothing queued</div>
            <div class="empty-hint">Add accounts and categories so the rotation has something to publish.</div>
          </div>
        <% } else { %>
          <dl class="kv">
            <dt>Next account</dt><dd><a class="link-quiet" href="/accounts/<%= next.accountId %>"><%= next.account %></a></dd>
            <dt>Next category</dt><dd><%= next.category %></dd>
            <dt>Cursor</dt>
            <dd class="mono small">
              <% if (rotation) { %>accountIndex <%= rotation.accountIndex %> · contentIndex <%= rotation.contentIndex %><% } else { %>not started<% } %>
            </dd>
          </dl>
        <% } %>
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>Runtime</h2>
        <span class="hint">read-only</span>
      </div>
      <div class="card-body">
        <dl class="kv">
          <dt>Public URL</dt><dd class="mono small"><%= publicUrl || 'not set' %></dd>
          <dt>AI model</dt><dd class="mono small"><%= aiModel || 'default' %></dd>
          <dt>Rendered files</dt><dd class="mono small">/videos/*</dd>
          <dt>Scheduler</dt>
          <dd><span class="badge <%= slotTimes.length ? 'ok' : 'warn' %>"><%= slotTimes.length ? 'active' : 'disabled' %></span></dd>
          <dt>Storage</dt><dd class="mono small">db.sqlite (WAL)</dd>
        </dl>
      </div>
    </section>

    <section class="card">
      <div class="card-body tight">
        <div class="row" style="gap:10px;align-items:flex-start">
          <span class="badge info">Tip</span>
          <p class="small muted" style="flex:1;min-width:200px;line-height:1.6">
            Changing cadence recomputes cron times on the next server boot. Use <strong>Generate post</strong> on
            Overview or Videos to run a slot immediately.
          </p>
        </div>
      </div>
    </section>
  </div>
</div>

<datalist id="tzList">
  <option value="America/New_York"></option>
  <option value="America/Chicago"></option>
  <option value="America/Denver"></option>
  <option value="America/Los_Angeles"></option>
  <option value="Europe/London"></option>
  <option value="Europe/Berlin"></option>
  <option value="Asia/Jakarta"></option>
  <option value="Asia/Singapore"></option>
  <option value="Asia/Tokyo"></option>
  <option value="Australia/Sydney"></option>
  <option value="UTC"></option>
</datalist>

<script>
async function saveCadence() {
  const btn = document.getElementById('saveCadence');
  btn.disabled = true;
  try {
    await UI.put('/api/settings', {
      videos_per_day: document.getElementById('set_vpd').value,
      window_start: document.getElementById('set_ws').value,
      window_end: document.getElementById('set_we').value,
      tz: document.getElementById('set_tz').value,
    });
    UI.toast('Cadence saved', 'ok');
    setTimeout(() => location.reload(), 600);
  } catch (err) {
    UI.toast(err.message, 'err');
    btn.disabled = false;
  }
}

async function saveBasePrompt() {
  const btn = document.getElementById('savePrompt');
  btn.disabled = true;
  try {
    await UI.put('/api/settings', { ai_base_prompt: document.getElementById('set_prompt').value });
    UI.toast('Base prompt saved', 'ok');
  } catch (err) {
    UI.toast(err.message, 'err');
  } finally {
    btn.disabled = false;
  }
}
</script>

<%- include('partials/foot') %>
