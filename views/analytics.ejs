<%- include('partials/head', { active: 'analytics', title: 'Analytics' }) %>
<style>
/* Content tokens — scoped to the shared shell's <main> so they only affect the
   analytics content and never leak into the shared rail/brand/nav (app.css owns those). */
.main{
  --bg:#f5f5f2;--panel:#fff;--panel-2:#fafaf7;
  --ink:#15171b;--ink-2:#3d4047;--muted:#71757d;--faint:#9a9da4;
  --line:#e7e5dd;--line-2:#d9d6cc;
  --accent:#2f6bff;--accent-soft:#eaf0ff;
  --ok:#0e9f6e;--ok-soft:#e7f7f0;--bad:#d64545;--bad-soft:#fdecec;--warn:#b7791f;
  --r:16px;--r-sm:10px;
  --shadow:0 1px 2px rgba(17,19,23,.04),0 14px 30px -22px rgba(17,19,23,.45);
}

/* main */
.main{padding:26px 30px 60px;max-width:1600px;width:100%;min-width:0}
.topbar{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:8px}
.topbar h1{font-size:27px;font-weight:750;letter-spacing:-.03em}
.topbar .sub{color:var(--muted);font-size:13px;margin-top:4px}
.topbar-actions{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.segmented{display:inline-flex;background:#ecebe5;border:1px solid var(--line);border-radius:10px;padding:3px;gap:2px}
.segmented button{border:none;background:transparent;color:var(--muted);font:inherit;font-size:12px;font-weight:600;padding:6px 11px;border-radius:8px;cursor:pointer}
.segmented button.on{background:#fff;color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.btn{border:1px solid var(--line-2);background:#fff;color:var(--ink);border-radius:10px;padding:8px 12px;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer;white-space:nowrap}
.btn:hover{background:#fbfbf8}
.btn.primary{background:var(--ink);border-color:var(--ink);color:#fff}
.btn.primary:hover{background:#2a2d33}
.meta-line{display:flex;align-items:center;gap:9px;flex-wrap:wrap;color:var(--muted);font-size:12.5px;margin:8px 0 18px}
.meta-line .pill{font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-radius:99px;padding:3px 8px}
.pill.ok{background:var(--ok-soft);color:var(--ok);border:1px solid #cdeade}
.pill.bad{background:var(--bad-soft);color:var(--bad);border:1px solid #f4cccc}
.pill.neutral{background:#f2f1ec;color:var(--muted);border:1px solid #e8e6df}

.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:12px;margin-bottom:20px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:15px 16px;box-shadow:var(--shadow)}
.kpi .lbl{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700}
.kpi .val{font-size:26px;font-weight:750;letter-spacing:-.03em;margin-top:7px;line-height:1.05}
.kpi .foot{font-size:11.5px;color:var(--faint);margin-top:6px}

.account{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);margin-bottom:16px;overflow:hidden}
.account>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:14px;padding:16px 18px;user-select:none}
.account>summary::-webkit-details-marker{display:none}
.account>summary:after{content:"";width:7px;height:7px;border-right:1.5px solid var(--muted);border-bottom:1.5px solid var(--muted);transform:rotate(45deg);margin-left:auto;transition:.15s;flex:none}
.account[open]>summary:after{transform:rotate(-135deg)}
.avatar{width:42px;height:42px;border-radius:12px;background:linear-gradient(145deg,#2f6bff,#7aa0ff);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;flex:none;letter-spacing:-.02em}
.acc-title h2{font-size:15px;font-weight:750;letter-spacing:-.02em}
.acc-title p{font-size:11.5px;color:var(--faint);margin-top:3px}
.acc-status{margin-left:auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.acc-body{padding:0 18px 20px;border-top:1px solid var(--line)}
.mini-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;padding:14px 0 4px}
.mini{background:var(--panel-2);border:1px solid #efeee8;border-radius:11px;padding:10px 12px}
.mini .lbl{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);font-weight:700}
.mini .val{font-size:17px;font-weight:750;letter-spacing:-.02em;margin-top:4px;font-variant-numeric:tabular-nums}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);margin-bottom:16px;overflow:hidden}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:15px 18px 0}
.panel-head h3{font-size:13px;font-weight:750;letter-spacing:-.01em}
.panel-head .hint{font-size:11.5px;color:var(--faint)}
.panel-body{padding:14px 18px 18px}
.chart{display:flex;flex-direction:column;gap:9px}
.chart-row{display:grid;grid-template-columns:150px minmax(0,1fr) 84px;align-items:center;gap:10px;font-size:12px}
.chart-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;color:var(--ink-2)}
.chart-track{height:12px;background:#f0efe9;border-radius:99px;overflow:hidden}
.chart-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#5b8bff,#2f6bff);min-width:2px;transition:width .25s}
.chart-value{text-align:right;font-variant-numeric:tabular-nums;font-weight:700;white-space:nowrap}
.chart-row:hover .chart-fill{filter:brightness(1.06)}
.channel-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px}
.channel-card{border:1px solid #efeee8;border-radius:12px;background:var(--panel-2);padding:12px 13px}
.channel-card-head{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:9px}
.channel-card-head .nm{font-size:12px;font-weight:700;letter-spacing:-.01em}
.channel-card-head .ct{margin-left:auto;font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.08em;font-weight:700}
.post-list{display:flex;flex-direction:column;gap:10px}
.post-card{border:1px solid #efeee8;border-radius:12px;background:var(--panel-2);padding:12px 13px}
.post-card-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px}
.post-card-head .when{font-size:11px;color:var(--faint)}
.post-card-head .open{margin-left:auto;font-size:11.5px;font-weight:600;color:var(--accent);text-decoration:none;white-space:nowrap}
.post-card-head .open:hover{text-decoration:underline}
.post-card-text{font-size:12.5px;line-height:1.55;color:var(--ink-2);white-space:pre-wrap;margin-bottom:10px;word-break:break-word}
.post-card .metric-grid{grid-template-columns:repeat(auto-fit,minmax(100px,1fr))}
.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(105px,1fr));gap:6px}
.metric-cell{background:#fff;border:1px solid #f0eee8;border-radius:9px;padding:8px 9px;min-width:0}
.metric-cell .k{font-size:9px;letter-spacing:.07em;text-transform:uppercase;color:var(--faint);font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.metric-cell .v{font-size:15px;font-weight:750;letter-spacing:-.02em;margin-top:3px;font-variant-numeric:tabular-nums}
.metric-cell .t{font-size:9px;color:var(--faint);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
table.t tbody tr:nth-child(even){background:#fcfcfa}
table.t tbody tr:hover{background:#f8f8f4}
.block{border-top:1px solid #f1efe9;padding-top:16px;margin-top:16px}
.block-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.block-head h3{font-size:13px;font-weight:750;letter-spacing:-.01em}
.block-head .hint{font-size:11.5px;color:var(--faint)}
.table-wrap{overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;border:1px solid #f0eee8;border-radius:11px}
table.t{width:100%;border-collapse:collapse;font-size:12px}
table.t th{text-align:left;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);font-weight:700;padding:9px 12px;border-bottom:1px solid var(--line);white-space:nowrap;background:#fcfcfa}
table.t td{padding:9px 12px;border-bottom:1px solid #f4f2ec;vertical-align:top}
table.t tr:last-child td{border-bottom:none}
table.t .num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
table.t .nowrap{white-space:nowrap}
.chip{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;font-weight:600;padding:3px 7px;border-radius:99px;background:#f2f1ec;color:var(--muted);border:1px solid #e8e6df;white-space:nowrap}
.chip.ok{background:var(--ok-soft);color:var(--ok);border-color:#cdeade}
.chip.bad{background:var(--bad-soft);color:var(--bad);border-color:#f4cccc}
.dot{width:7px;height:7px;border-radius:50%;display:inline-block;background:var(--faint);flex:none}
.dot.ok{background:var(--ok);box-shadow:0 0 0 3px var(--ok-soft)}
.dot.bad{background:var(--bad);box-shadow:0 0 0 3px var(--bad-soft)}
.muted{color:var(--muted)}
.small{font-size:11px}
details.sub{border:1px solid #f0eee8;border-radius:11px;padding:10px 12px;margin-bottom:8px;background:var(--panel-2)}
details.sub>summary{list-style:none;cursor:pointer;font-size:12px;font-weight:650;display:flex;align-items:center;gap:8px}
details.sub>summary::-webkit-details-marker{display:none}
details.sub>summary:after{content:"+";margin-left:auto;color:var(--faint);font-weight:700}
details.sub[open]>summary:after{content:"–"}
details.sub .table-wrap{margin-top:10px;background:#fff}
details.json-item{border:1px solid #f0eee8;border-radius:11px;margin-bottom:8px;background:var(--panel-2);overflow:hidden}
details.json-item>summary{list-style:none;cursor:pointer;padding:11px 12px;font-size:12px;font-weight:650;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
details.json-item>summary::-webkit-details-marker{display:none}
details.json-item>summary:after{content:"View JSON";margin-left:auto;color:var(--accent);font-size:11px;font-weight:650}
details.json-item[open]>summary:after{content:"Hide JSON"}
pre.json{margin:0;padding:12px 14px;border-top:1px solid #f0eee8;background:#0f1115;color:#d7dbe2;font:11.5px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;overflow:auto;max-height:440px;white-space:pre}
.json-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.error-box{background:var(--bad-soft);border:1px solid #f4cccc;color:#8f2f2f;border-radius:10px;padding:10px 12px;font-size:12px;margin:12px 0}
.empty{color:var(--faint);font-size:12px;padding:12px 2px}
.loading{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px;padding:38px 0}
.spinner{width:16px;height:16px;border-radius:50%;border:2px solid #dcdad2;border-top-color:var(--accent);animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.meta-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;margin:12px 0 2px}
.meta-item{background:var(--panel-2);border:1px solid #efeee8;border-radius:10px;padding:9px 11px;min-width:0}
.meta-item .k{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);font-weight:700}
.meta-item .v{font-size:12px;color:var(--ink-2);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

@media(max-width:900px){
  .main{padding:20px 16px 48px}
  .topbar{align-items:flex-start}
  .chart-row{grid-template-columns:110px minmax(0,1fr) 72px}
}
</style>
</head>
<body>
    <header class="topbar">
      <div>
        <h1>Analytics</h1>
        <p class="sub">Complete Buffer analytics and generated content for every account</p>
      </div>
      <div class="topbar-actions">
        <div class="segmented" id="rangePicker">
          <button data-days="7" onclick="setRange(7)">7d</button>
          <button data-days="30" class="on" onclick="setRange(30)">30d</button>
          <button data-days="90" onclick="setRange(90)">90d</button>
        </div>
        <button class="btn" id="refreshBtn" onclick="load(true)">Refresh</button>
        <button class="btn" id="auditBtn" onclick="downloadAudit()" disabled>Download audit (.md)</button>
        <button class="btn primary" id="downloadAllBtn" onclick="downloadAll()" disabled>Download all JSON</button>
      </div>
    </header>

    <div class="meta-line" id="metaLine">
      <span class="pill neutral">Buffer</span>
      <span>Loading analytics…</span>
    </div>

    <div id="kpis" class="kpis"></div>

    <section class="panel">
      <div class="panel-head">
        <div>
          <h3>Account comparison</h3>
          <div class="hint" id="chartHint">Buffer aggregated value for the selected range</div>
        </div>
        <div class="segmented" id="chartPicker">
          <button data-metric="views" class="on" onclick="setChartMetric('views')">Views</button>
          <button data-metric="reactions" onclick="setChartMetric('reactions')">Reactions</button>
          <button data-metric="comments" onclick="setChartMetric('comments')">Comments</button>
          <button data-metric="postCount" onclick="setChartMetric('postCount')">Posts</button>
          <button data-metric="engagementRate" onclick="setChartMetric('engagementRate')">Eng. Rate</button>
        </div>
      </div>
      <div class="panel-body">
        <div id="accountChart" class="chart"></div>
      </div>
    </section>

    <div id="accounts"></div>
    <div id="state" class="loading"><span class="spinner"></span><span>Fetching every Buffer account…</span></div>

<script>
const state = { days: 30, data: null, loading: false, chartMetric: "views" };

const METRIC_ORDER = ["postCount","views","reach","impressions","reactions","comments","shares","saves","clicks","follows","engagementRate","quotes","reposts","likes","viewers","averageTimeWatched","totalTimeWatched","freeSubscriptions","paidSubscriptions"];

function esc(v){
  return String(v == null ? "" : v)
    .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function fmt(n){
  if (n == null || !Number.isFinite(Number(n))) return "—";
  const v = Number(n);
  if (Math.abs(v) >= 1000) return new Intl.NumberFormat("en-US").format(v);
  if (!Number.isInteger(v)) return String(Math.round(v * 100) / 100);
  return String(v);
}
function fmtMetric(m){
  if (!m) return "—";
  return fmt(m.value) + (m.unit === "percentage" ? "%" : "");
}
function metricLabel(type, metrics){
  const m = (metrics || []).find((x) => x.type === type);
  return m?.name || type;
}
function shortDate(value){
  if (!value) return "—";
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return esc(value);
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}
function shortDateTime(value){
  if (!value) return "—";
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return esc(value);
  return d.toLocaleString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
}
function initials(name){
  const s = String(name || "?").replace(/^@/, "").replace(/[^a-zA-Z0-9]/g, "");
  return esc((s.slice(0, 2) || "?").toUpperCase());
}
function serviceLabel(service){
  return String(service || "").replace(/^./, (c) => c.toUpperCase());
}
function postMetric(post, type){
  return (post.metrics || []).find((m) => m.type === type);
}
function kpi(label, value, foot){
  return `<div class="kpi"><div class="lbl">${esc(label)}</div><div class="val">${value}</div><div class="foot">${esc(foot || "")}</div></div>`;
}
function accountMetric(a, type){
  return (a.buffer?.aggregated?.metrics || []).find((m) => m.type === type) || null;
}
function renderChart(){
  const d = state.data;
  if (!d) return;
  const type = state.chartMetric;
  const sample = d.accounts.map((a) => accountMetric(a, type)).find(Boolean);
  const unit = sample?.unit;
  const label = sample?.name || type;
  const rows = d.accounts
    .map((a) => ({ name: a.account, value: Number(accountMetric(a, type)?.value) || 0 }))
    .sort((a, b) => b.value - a.value);
  const max = Math.max(...rows.map((r) => r.value), 1);
  document.getElementById("chartHint").textContent = `${label} · ${d.range.days}-day range · all ${d.accounts.length} accounts`;
  document.getElementById("accountChart").innerHTML = rows.map((r) => `
    <div class="chart-row" title="${esc(r.name)} — ${esc(fmtMetric({ value: r.value, unit }))}">
      <div class="chart-label">${esc(r.name)}</div>
      <div class="chart-track"><div class="chart-fill" style="width:${r.value ? Math.max(1.5, (r.value / max) * 100) : 0}%"></div></div>
      <div class="chart-value">${esc(fmtMetric({ value: r.value, unit }))}</div>
    </div>`).join("");
}
function setChartMetric(type){
  state.chartMetric = type;
  document.querySelectorAll("#chartPicker button").forEach((b) => b.classList.toggle("on", b.dataset.metric === type));
  renderChart();
}

function renderKpis(){
  const d = state.data;
  if (!d) return;
  const local = d.totals.local;
  const order = (t) => {
    const i = METRIC_ORDER.indexOf(t);
    return i < 0 ? 99 : i;
  };
  const metrics = [...(d.totals.buffer || [])].sort((a, b) => order(a.type) - order(b.type));
  const cards = [
    kpi("Accounts", `${d.summary.connected}/${d.summary.accounts}`, "Buffer connected"),
    kpi("Channels", fmt(d.summary.channels), `${d.summary.organizations} organization${d.summary.organizations === 1 ? "" : "s"}`),
    ...metrics.map((m) => kpi(
      m.type === "postCount" ? "Buffer posts" : (m.name || m.type),
      fmtMetric(m),
      m.type === "postCount" ? `${d.range.days}-day range` : (m.type === "engagementRate" ? "Reactions ÷ views" : "Buffer aggregated")
    )),
    kpi("Generated locally", fmt(local.generated), `${fmt(local.success)} success · ${fmt(local.pending)} pending`),
    kpi("Local success rate", `${fmt(local.successRate)}%`, `${fmt(local.failed)} failed`),
  ];

  document.getElementById("kpis").innerHTML = cards.join("");
}

function renderMeta(){
  const d = state.data;
  if (!d) return;
  const when = new Date(d.generatedAt).toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit" });
  document.getElementById("metaLine").innerHTML = `
    <span class="pill neutral">Buffer</span>
    <span><strong>${esc(String(d.range.days))}-day range</strong> · ${esc(shortDate(d.range.start))} – ${esc(shortDate(d.range.end))}</span>
    <span>·</span>
    <span>Updated ${esc(when)}</span>
    <span>·</span>
    <span>${fmt(d.summary.posts)} latest Buffer posts loaded</span>
  `;
}

function renderChannels(a){
  const channels = a.buffer?.channels || [];
  if (!channels.length) return `<div class="empty">No channels returned by Buffer.</div>`;
  return `
    <div class="table-wrap">
      <table class="t">
        <thead><tr>
          <th>Service</th><th>Channel</th><th>Type</th><th>Descriptor</th><th>Status</th><th>Timezone</th><th>Created</th><th>Link</th>
        </tr></thead>
        <tbody>
          ${channels.map((c) => {
            const flags = [];
            if (c.isDisconnected) flags.push('<span class="chip bad">Disconnected</span>');
            if (c.isLocked) flags.push('<span class="chip bad">Locked</span>');
            if (c.isQueuePaused) flags.push('<span class="chip">Queue paused</span>');
            if (!flags.length) flags.push('<span class="chip ok">Active</span>');
            return `<tr>
              <td><span class="chip">${esc(serviceLabel(c.service))}</span></td>
              <td class="nowrap"><strong>${esc(c.name || c.displayName || "—")}</strong></td>
              <td>${esc(c.type || "—")}</td>
              <td>${esc(c.descriptor || "—")}</td>
              <td>${flags.join(" ")}</td>
              <td class="nowrap">${esc(c.timezone || "—")}</td>
              <td class="nowrap">${esc(shortDate(c.createdAt))}</td>
              <td>${c.externalLink ? `<a href="${esc(c.externalLink)}" target="_blank" rel="noopener">Open</a>` : "—"}</td>
            </tr>`;
          }).join("")}
        </tbody>
      </table>
    </div>`;
}

function renderAggregated(a){
  const agg = a.buffer?.aggregated;
  const metrics = agg?.metrics || [];
  if (!metrics.length) return `<div class="empty">Buffer did not return aggregated metrics for this range.</div>`;
  return `
    <div class="table-wrap">
      <table class="t">
        <thead><tr><th>Metric</th><th>Type</th><th>Unit</th><th class="num">Value</th><th>Description</th></tr></thead>
        <tbody>
          ${metrics.map((m) => `<tr>
            <td class="nowrap"><strong>${esc(m.name || m.type)}</strong></td>
            <td><code>${esc(m.type)}</code></td>
            <td>${esc(m.unit || "—")}</td>
            <td class="num">${fmtMetric(m)}</td>
            <td class="muted small">${esc(m.description || "")}</td>
          </tr>`).join("")}
        </tbody>
      </table>
    </div>`;
}

function renderChannelMetrics(a){
  const rows = (a.buffer?.organizations || []).flatMap((o) => (o.channelMetrics || []).map((m) => ({ ...m, organization: o.name })));
  if (!rows.length) return `<div class="empty">No per-channel metrics available.</div>`;
  return `<div class="channel-grid">${rows.map((row) => {
    const metrics = row.metrics || [];
    return `<div class="channel-card">
      <div class="channel-card-head">
        <span class="chip">${esc(serviceLabel(row.service))}</span>
        <span class="nm">${esc(row.channel_name || row.channel_id)}</span>
        <span class="ct">${fmt(metrics.length)} values</span>
      </div>
      ${row.error ? `<div class="error-box">${esc(row.error)}</div>` : ""}
      ${metrics.length ? `
      <div class="metric-grid">
        ${metrics.map((m) => `<div class="metric-cell" title="${esc(m.description || m.name || m.type)}">
          <div class="k">${esc(m.name || m.type)}</div>
          <div class="v">${fmtMetric(m)}</div>
          <div class="t">${esc(m.type)}${m.unit === "percentage" ? " · %" : ""}</div>
        </div>`).join("")}
      </div>` : `<div class="empty">No metrics for this channel in the selected range.</div>`}
    </div>`;
  }).join("")}</div>`;
}

function renderPosts(a){
  const posts = a.buffer?.posts || [];
  if (!posts.length) return `<div class="empty">No sent Buffer posts in this range.</div>`;
  const channelById = Object.fromEntries((a.buffer?.channels || []).map((c) => [c.id, c]));
  const pageInfo = (a.buffer?.organizations || []).find((o) => o.postsPageInfo)?.postsPageInfo;
  return `
    <div class="post-list">
      ${posts.map((p) => {
        const ch = channelById[p.channelId];
        const metrics = [...(p.metrics || [])].sort((x, y) => {
          const ix = METRIC_ORDER.indexOf(x.type), iy = METRIC_ORDER.indexOf(y.type);
          return (ix < 0 ? 99 : ix) - (iy < 0 ? 99 : iy) || String(x.type).localeCompare(String(y.type));
        });
        return `<article class="post-card">
          <div class="post-card-head">
            <span class="chip">${esc(serviceLabel(p.channelService || ch?.service))}</span>
            <strong>${esc(ch?.name || "Post")}</strong>
            <span class="when">${esc(shortDateTime(p.sentAt || p.createdAt))}</span>
            ${p.externalLink ? `<a class="open" href="${esc(p.externalLink)}" target="_blank" rel="noopener">Open post ↗</a>` : ""}
          </div>
          <div class="post-card-text">${esc(p.text || "No post text")}</div>
          ${metrics.length ? `<div class="metric-grid">
            ${metrics.map((m) => `<div class="metric-cell" title="${esc(m.description || m.name || m.type)}">
              <div class="k">${esc(m.name || m.type)}</div>
              <div class="v">${fmtMetric(m)}</div>
              <div class="t">${esc(m.type)}${m.unit === "percentage" ? " · %" : ""}</div>
            </div>`).join("")}
          </div>` : `<div class="empty">No metrics reported for this post yet.</div>`}
        </article>`;
      }).join("")}
    </div>
    ${pageInfo?.hasNextPage ? `<div class="hint" style="margin-top:8px">Showing the latest ${posts.length} sent posts. More posts are available in Buffer.</div>` : ""}`;
}

function renderGenerated(a){
  const items = a.local?.latest5 || [];
  if (!items.length) return `<div class="empty">No generated content for this account yet.</div>`;
  return items.map((v) => {
    const summary = `#${v.id} · ${esc(shortDateTime(v.created_at))} · ${esc(v.category_name || "Uncategorized")} · ${esc(v.status)}`;
    const hook = v.hook ? ` · ${esc(String(v.hook).slice(0, 80))}${String(v.hook).length > 80 ? "…" : ""}` : "";
    return `<details class="json-item">
      <summary><span>${summary}${hook}</span></summary>
      <pre class="json">${esc(JSON.stringify(v, null, 2))}</pre>
    </details>`;
  }).join("");
}

function renderAccount(a){
  const orgs = a.buffer?.organizations || [];
  const totalPosts = (a.buffer?.aggregated?.metrics || []).find((x) => x.type === "postCount")?.value;
  const orgNames = orgs.map((o) => o.name).filter(Boolean).join(", ");
  const link = a.link ? `<a href="https://${esc(a.link)}" target="_blank" rel="noopener" style="color:inherit;text-decoration:none">${esc(a.link)}</a>` : "";
  const accountMeta = a.buffer?.account;
  const status = a.ok
    ? `<span class="pill ok">Buffer connected</span>`
    : `<span class="pill bad">Buffer error</span>`;
  return `<details class="account" open>
    <summary>
      <div class="avatar">${initials(a.account)}</div>
      <div class="acc-title">
        <h2>${esc(a.account)}</h2>
        <p>${link}${link && orgNames ? " · " : ""}${esc(orgNames)}</p>
      </div>
      <div class="acc-status">${status}<span class="chip">${fmt(a.buffer?.posts?.length || 0)} posts loaded</span></div>
    </summary>
    <div class="acc-body">
      ${a.error ? `<div class="error-box">${esc(a.error)}</div>` : ""}
      <div class="mini-kpis">
        ${(a.buffer?.aggregated?.metrics || []).map((m) => `<div class="mini"><div class="lbl">${esc(m.type === "postCount" ? "Posts" : (m.name || m.type))}</div><div class="val">${fmtMetric(m)}</div></div>`).join("")}
        <div class="mini"><div class="lbl">Generated local</div><div class="val">${fmt(a.local?.stats?.generated || 0)}</div></div>
        <div class="mini"><div class="lbl">Local success</div><div class="val">${fmt(a.local?.stats?.success || 0)}</div></div>
        <div class="mini"><div class="lbl">Local failed</div><div class="val">${fmt(a.local?.stats?.failed || 0)}</div></div>
        <div class="mini"><div class="lbl">Local pending</div><div class="val">${fmt(a.local?.stats?.pending || 0)}</div></div>
      </div>

      ${accountMeta ? `<div class="meta-grid">
        <div class="meta-item"><div class="k">Buffer account</div><div class="v">${esc(accountMeta.name || "—")}</div></div>
        <div class="meta-item"><div class="k">Email</div><div class="v">${esc(accountMeta.email || "—")}</div></div>
        <div class="meta-item"><div class="k">Timezone</div><div class="v">${esc(accountMeta.timezone || "—")}</div></div>
        <div class="meta-item"><div class="k">Account created</div><div class="v">${esc(shortDate(accountMeta.createdAt))}</div></div>
        <div class="meta-item"><div class="k">Organization</div><div class="v">${esc(orgNames || "—")}</div></div>
      </div>` : ""}

      <div class="block">
        <div class="block-head"><h3>Channels</h3><span class="hint">Everything Buffer returns for each connected channel</span></div>
        ${renderChannels(a)}
      </div>

      <div class="block">
        <div class="block-head"><h3>Aggregated Buffer metrics</h3><span class="hint">${esc(String(state.days))}-day range · updated ${esc(shortDateTime(a.buffer?.aggregated?.metricsUpdatedAt))}</span></div>
        ${renderAggregated(a)}
      </div>

      <div class="block">
        <div class="block-head"><h3>Per-channel metrics</h3><span class="hint">Aggregated separately for every channel</span></div>
        ${renderChannelMetrics(a)}
      </div>

      <div class="block">
        <div class="block-head"><h3>Latest Buffer posts</h3><span class="hint">Latest ${fmt(a.buffer?.posts?.length || 0)}${totalPosts ? ` of ${fmt(totalPosts)}` : ""} sent posts with every metric Buffer exposes</span></div>
        ${renderPosts(a)}
      </div>

      <div class="block">
        <div class="block-head"><h3>Generated content — latest 5</h3><span class="hint">Stored in our SQLite DB at generation time, shown as JSON</span></div>
        ${renderGenerated(a)}
        <div class="json-actions">
          <button class="btn primary" onclick="downloadAccountAudit(${a.account_id})">Download account audit (.md)</button>
          <button class="btn" onclick="downloadAccount(${a.account_id})">Download this account JSON</button>
        </div>
      </div>
    </div>
  </details>`;
}

function render(){
  const d = state.data;
  document.getElementById("state").style.display = "none";
  if (!d) return;
  renderMeta();
  renderKpis();
  renderChart();
  document.getElementById("accounts").innerHTML = d.accounts.map(renderAccount).join("");
  document.getElementById("auditBtn").disabled = false;
  document.getElementById("downloadAllBtn").disabled = false;
}

function setRange(days){
  state.days = days;
  document.querySelectorAll("#rangePicker button").forEach((b) => b.classList.toggle("on", Number(b.dataset.days) === days));
  load();
}

async function load(refresh){
  if (state.loading) return;
  state.loading = true;
  const stateEl = document.getElementById("state");
  stateEl.style.display = "flex";
  stateEl.innerHTML = `<span class="spinner"></span><span>Fetching every Buffer account…</span>`;
  document.getElementById("refreshBtn").disabled = true;
  try {
    const res = await fetch(`/api/analytics/full?days=${state.days}${refresh ? "&refresh=1" : ""}`, { headers: { Accept: "application/json" } });
    if (res.status === 401) {
      stateEl.innerHTML = `<span>Session expired. Reload the page to sign in again.</span>`;
      return;
    }
    if (!res.ok) throw new Error(`Request failed (${res.status})`);
    state.data = await res.json();
    render();
  } catch (err) {
    stateEl.style.display = "flex";
    stateEl.innerHTML = `<span>Could not load analytics: ${esc(err.message)}</span>`;
  } finally {
    state.loading = false;
    document.getElementById("refreshBtn").disabled = false;
  }
}

function mdCell(value){
  const text = String(value == null ? "" : value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\|/g, "\\|")
    .replace(/\r?\n/g, "<br>")
    .replace(/[ \t]+/g, " ")
    .trim();
  return text || "—";
}
function channelStatusText(c){
  const flags = [];
  if (c.isDisconnected) flags.push("Disconnected");
  if (c.isLocked) flags.push("Locked");
  if (c.isQueuePaused) flags.push("Queue paused");
  return flags.length ? flags.join(", ") : "Active";
}
function postMetricTypes(posts){
  const present = new Set();
  for (const p of posts) for (const m of p.metrics || []) present.add(m.type);
  return [...present].sort((x, y) => {
    const ix = METRIC_ORDER.indexOf(x), iy = METRIC_ORDER.indexOf(y);
    return (ix < 0 ? 99 : ix) - (iy < 0 ? 99 : iy) || x.localeCompare(y);
  });
}
function accountMarkdown(a){
  const d = state.data;
  const metrics = a.buffer?.aggregated?.metrics || [];
  const channels = a.buffer?.channels || [];
  const posts = (a.buffer?.posts || []).slice(0, 5);
  const types = postMetricTypes(posts);
  const allPostMetrics = posts.flatMap((p) => p.metrics || []);
  const orgs = a.buffer?.organizations || [];
  const orgNames = orgs.map((o) => o.name).filter(Boolean).join(", ");
  const accountMeta = a.buffer?.account;
  const local = a.local?.stats || {};
  const totalPosts = metrics.find((m) => m.type === "postCount")?.value;
  const lines = [];

  lines.push(`## ${mdCell(a.account || `Account ${a.account_id}`)}`);
  lines.push("");
  lines.push(`- **Account:** ${mdCell(a.account)}`);
  if (a.link) lines.push(`- **Link:** https://${a.link}`);
  if (accountMeta?.name) lines.push(`- **Buffer account:** ${mdCell(accountMeta.name)}`);
  if (accountMeta?.email) lines.push(`- **Email:** ${mdCell(accountMeta.email)}`);
  if (accountMeta?.timezone) lines.push(`- **Timezone:** ${mdCell(accountMeta.timezone)}`);
  if (orgNames) lines.push(`- **Organization:** ${mdCell(orgNames)}`);
  lines.push(`- **Buffer status:** ${a.ok ? "Connected" : "Error"}`);
  if (a.error) lines.push(`- **Buffer error:** ${mdCell(a.error)}`);
  lines.push(`- **Range:** ${d.range.days} days (${shortDate(d.range.start)} – ${shortDate(d.range.end)})`);
  lines.push(`- **Generated at:** ${shortDateTime(d.generatedAt)}`);
  lines.push("");

  lines.push("### Key values");
  lines.push("");
  lines.push("| Metric | Value |");
  lines.push("| --- | ---: |");
  for (const m of metrics) lines.push(`| ${mdCell(m.name || m.type)} | ${fmtMetric(m)} |`);
  lines.push(`| Generated local | ${local.generated ?? 0} |`);
  lines.push(`| Local success | ${local.success ?? 0} |`);
  lines.push(`| Local failed | ${local.failed ?? 0} |`);
  lines.push(`| Local pending | ${local.pending ?? 0} |`);
  if (local.lastAt) lines.push(`| Last generated | ${mdCell(shortDateTime(local.lastAt))} |`);
  lines.push("");

  lines.push("### Channels");
  lines.push("");
  if (channels.length) {
    lines.push("| Service | Channel | Type | Descriptor | Status | Timezone | Created | Link |");
    lines.push("| --- | --- | --- | --- | --- | --- | --- | --- |");
    for (const c of channels) {
      lines.push(`| ${mdCell(serviceLabel(c.service))} | ${mdCell(c.name || c.displayName)} | ${mdCell(c.type)} | ${mdCell(c.descriptor)} | ${mdCell(channelStatusText(c))} | ${mdCell(c.timezone)} | ${mdCell(shortDate(c.createdAt))} | ${c.externalLink ? `[Open](${c.externalLink})` : "—"} |`);
    }
  } else {
    lines.push("No channels returned by Buffer.");
  }
  lines.push("");

  lines.push("### Aggregated Buffer metrics");
  lines.push("");
  if (metrics.length) {
    lines.push("| Metric | Type | Unit | Value | Description |");
    lines.push("| --- | --- | --- | ---: | --- |");
    for (const m of metrics) {
      lines.push(`| ${mdCell(m.name || m.type)} | ${mdCell(m.type)} | ${mdCell(m.unit)} | ${fmtMetric(m)} | ${mdCell(m.description)} |`);
    }
  } else {
    lines.push("Buffer did not return aggregated metrics for this range.");
  }
  lines.push("");

  lines.push("### Per-channel metrics");
  lines.push("");
  const channelRows = orgs.flatMap((o) => o.channelMetrics || []);
  if (channelRows.length) {
    for (const row of channelRows) {
      const values = row.metrics || [];
      lines.push(`#### ${mdCell(serviceLabel(row.service))} — ${mdCell(row.channel_name || row.channel_id)} (${values.length} values)`);
      lines.push("");
      if (row.error) {
        lines.push(`> **Error:** ${mdCell(row.error)}`);
        lines.push("");
      }
      if (values.length) {
        lines.push("| Metric | Type | Unit | Value | Description |");
        lines.push("| --- | --- | --- | ---: | --- |");
        for (const m of values) lines.push(`| ${mdCell(m.name || m.type)} | ${mdCell(m.type)} | ${mdCell(m.unit)} | ${fmtMetric(m)} | ${mdCell(m.description)} |`);
      } else {
        lines.push("No metrics for this channel in the selected range.");
      }
      lines.push("");
    }
  } else {
    lines.push("No per-channel metrics available.");
    lines.push("");
  }

  lines.push(`### Latest Buffer posts (${posts.length}${totalPosts ? ` of ${fmt(totalPosts)}` : ""})`);
  lines.push("");
  if (posts.length) {
    lines.push(`| Sent | Channel | Post | ${types.map((t) => mdCell(metricLabel(t, allPostMetrics))).join(" | ")} | Link |`);
    lines.push(`| --- | --- | --- | ${types.map(() => "---:").join(" | ")} | --- |`);
    for (const p of posts) {
      const ch = channels.find((c) => c.id === p.channelId);
      const cells = [
        mdCell(shortDateTime(p.sentAt || p.createdAt)),
        mdCell(`${serviceLabel(p.channelService || ch?.service)} ${ch?.name || ""}`),
        mdCell(p.text || ""),
        ...types.map((t) => fmtMetric(postMetric(p, t))),
        p.externalLink ? `[Open](${p.externalLink})` : "—",
      ];
      lines.push(`| ${cells.join(" | ")} |`);
    }
  } else {
    lines.push("No sent Buffer posts in this range.");
  }
  lines.push("");

  lines.push("### Generated content — latest 5 (JSON)");
  lines.push("");
  lines.push("````json");
  lines.push(JSON.stringify(a.local?.latest5 || [], null, 2));
  lines.push("````");
  lines.push("");

  return lines.join("\n");
}
function auditMarkdown(){
  const d = state.data;
  if (!d) return "";
  const local = d.totals.local;
  const lines = [];
  lines.push("# 1section Analytics Audit");
  lines.push("");
  lines.push(`- **Generated at:** ${shortDateTime(d.generatedAt)}`);
  lines.push(`- **Range:** ${d.range.days} days (${shortDate(d.range.start)} – ${shortDate(d.range.end)})`);
  lines.push(`- **Accounts:** ${d.summary.connected}/${d.summary.accounts} connected`);
  lines.push(`- **Organizations:** ${d.summary.organizations}`);
  lines.push(`- **Channels:** ${d.summary.channels}`);
  for (const m of d.totals.buffer || []) lines.push(`- **${mdCell(m.name || m.type)}:** ${fmtMetric(m)}`);
  lines.push(`- **Generated local:** ${local.generated} (${local.success} success · ${local.failed} failed · ${local.pending} pending)`);
  lines.push("");
  lines.push("## Account overview");
  lines.push("");
  lines.push("| Account | Posts | Views | Reactions | Comments | Eng. Rate | Generated local |");
  lines.push("| --- | ---: | ---: | ---: | ---: | ---: | ---: |");
  for (const a of d.accounts) {
    const value = (type) => fmtMetric(accountMetric(a, type));
    lines.push(`| ${mdCell(a.account)} | ${value("postCount")} | ${value("views")} | ${value("reactions")} | ${value("comments")} | ${value("engagementRate")} | ${a.local?.stats?.generated ?? 0} |`);
  }
  lines.push("");
  for (const a of d.accounts) {
    lines.push("---");
    lines.push("");
    lines.push(accountMarkdown(a));
  }
  return lines.join("\n");
}
function downloadText(filename, text, type = "text/markdown;charset=utf-8"){
  const blob = new Blob([text], { type });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}
function downloadAudit(){
  if (!state.data) return;
  downloadText(`1section-analytics-audit-${state.days}d-${new Date().toISOString().slice(0, 10)}.md`, auditMarkdown());
}
function downloadAccountAudit(id){
  const a = state.data?.accounts?.find((x) => x.account_id === id);
  if (!a) return;
  const safe = String(a.account || "account").replace(/[^a-zA-Z0-9._-]/g, "-");
  downloadText(`1section-${safe}-audit-${state.days}d-${new Date().toISOString().slice(0, 10)}.md`, accountMarkdown(a));
}
function downloadJson(filename, data){
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}
function downloadAll(){
  if (!state.data) return;
  downloadJson(`1section-analytics-${state.days}d-${new Date().toISOString().slice(0,10)}.json`, state.data);
}
function downloadAccount(id){
  const a = state.data?.accounts?.find((x) => x.account_id === id);
  if (!a) return;
  const safe = String(a.account || "account").replace(/[^a-zA-Z0-9._-]/g, "-");
  downloadJson(`1section-${safe}-${state.days}d-${new Date().toISOString().slice(0,10)}.json`, a);
}

load();
</script>
