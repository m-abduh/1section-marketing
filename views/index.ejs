<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>1section Marketing</title>
<style>
:root{
  --bg:#f5f5f2;--panel:#fff;--panel-2:#fafaf7;
  --ink:#15171b;--ink-2:#3d4047;--muted:#71757d;--faint:#9a9da4;
  --line:#e7e5dd;--line-2:#d9d6cc;
  --accent:#2f6bff;--accent-soft:#eaf0ff;
  --ok:#0e9f6e;--ok-soft:#e7f7f0;--bad:#d64545;--bad-soft:#fdecec;--warn:#b7791f;
  --r:16px;--r-sm:10px;
  --shadow:0 1px 2px rgba(17,19,23,.04),0 14px 30px -22px rgba(17,19,23,.45);
  --side:#111317;--side-2:#171a1f;--side-line:#252a31;--side-ink:#e9eaee;--side-muted:#8d929b;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
.app{display:grid;grid-template-columns:272px minmax(0,1fr);min-height:100vh}

/* ---------- sidebar ---------- */
.sidebar{position:sticky;top:0;height:100vh;overflow-y:auto;background:var(--side);color:var(--side-ink);display:flex;flex-direction:column}
.brand{display:flex;align-items:center;gap:12px;padding:22px 20px 18px}
.brand .mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(145deg,#2f6bff,#6f9bff);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;color:#fff;box-shadow:0 6px 18px -6px rgba(47,107,255,.8)}
.brand .name{font-size:15px;font-weight:700;letter-spacing:-.01em}
.brand .tag{font-size:11px;color:var(--side-muted);letter-spacing:.14em;text-transform:uppercase;margin-top:2px}
.side-block{border-top:1px solid var(--side-line);padding:14px 16px 16px}
.side-block>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--side-muted);font-weight:700;user-select:none}
.side-block>summary::-webkit-details-marker{display:none}
.side-block>summary:after{content:"";width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);margin-right:2px;transition:.15s}
.side-block[open]>summary:after{transform:rotate(-135deg)}
.side-block .body{padding-top:12px}
.side-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px 10px}
.side-head span{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--side-muted);font-weight:700}
.icon-btn{width:26px;height:26px;border-radius:8px;border:1px solid var(--side-line);background:var(--side-2);color:var(--side-ink);cursor:pointer;font-size:15px;line-height:1;display:flex;align-items:center;justify-content:center}
.icon-btn:hover{background:#20242b}
.account-list{display:flex;flex-direction:column;gap:6px;padding:0 12px}
.acc{display:flex;align-items:center;justify-content:space-between;gap:8px;background:transparent;border:1px solid transparent;border-radius:11px;padding:9px 10px;cursor:pointer;transition:.15s}
.acc:hover{background:var(--side-2);border-color:var(--side-line)}
.acc.active{background:#1b2130;border-color:#31405f}
.acc .name{font-weight:600;font-size:13px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.acc .sub{display:block;font-weight:400;font-size:11px;color:var(--side-muted);margin-top:2px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.acc .acts{display:flex;align-items:center;gap:2px;opacity:0;transition:.15s}
.acc:hover .acts,.acc.active .acts{opacity:1}
.acc .acts button{background:none;border:none;color:var(--side-muted);cursor:pointer;font-size:11px;padding:4px 5px;border-radius:6px}
.acc .acts button:hover{color:#fff;background:#252a31}
.acc .acts .del:hover{color:#ff8a8a;background:#2a1b1b}
.side-btn{width:100%;margin-top:10px;display:inline-flex;align-items:center;justify-content:center;gap:7px;background:#1c2027;border:1px solid var(--side-line);color:var(--side-ink);padding:9px 12px;border-radius:10px;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer}
.side-btn:hover{background:#232830}
.field{display:block;margin-bottom:10px}
.field>span{display:block;font-size:11px;color:var(--side-muted);margin-bottom:5px;font-weight:600;letter-spacing:.02em}
.sidebar input,.sidebar select,.sidebar textarea{width:100%;background:#0d0f12;border:1px solid var(--side-line);color:var(--side-ink);border-radius:9px;padding:8px 9px;font:inherit;font-size:12.5px}
.sidebar input:focus,.sidebar textarea:focus{outline:none;border-color:#3c4c6e}
.sidebar .row2{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.sidebar input[type=time]{padding:7px 4px;font-size:10.5px}
.sidebar input[type=time]::-webkit-calendar-picker-indicator{display:none}
.sidebar input[type=file]{padding:7px;font-size:11px;color:var(--side-muted)}
.sidebar input[type=file]::file-selector-button{background:#232830;border:1px solid var(--side-line);color:var(--side-ink);border-radius:7px;padding:5px 8px;margin-right:8px;font:inherit;font-size:11px;cursor:pointer}
.sidebar .muted{color:var(--side-muted);font-size:11px;line-height:1.5}
.cat-mini{display:flex;align-items:center;justify-content:space-between;background:var(--side-2);border:1px solid var(--side-line);border-radius:9px;padding:7px 9px;margin-bottom:5px;cursor:pointer;font-size:12.5px}
.cat-mini:hover{border-color:#31405f}
.cat-mini .x{background:none;border:none;color:var(--side-muted);cursor:pointer;font-size:11px;padding:2px 4px;border-radius:5px}
.cat-mini .x:hover{color:#ff8a8a;background:#2a1b1b}
.music-item{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--side-line)}
.music-item:last-child{border-bottom:none}
.music-item .nm{flex:1;min-width:0;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.music-item .sz{font-size:10.5px;color:var(--side-muted)}
.music-item button{background:none;border:none;color:var(--side-muted);cursor:pointer;font-size:11px;padding:2px 4px;border-radius:5px}
.music-item button:hover{color:#fff}
.music-item audio{display:none}

/* ---------- main ---------- */
.main{padding:26px 30px 56px;max-width:1440px;width:100%;min-width:0}
.topbar{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:6px}
.topbar h1{font-size:26px;font-weight:750;letter-spacing:-.03em}
.topbar .sub{color:var(--muted);font-size:13px;margin-top:4px}
.topbar-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.segmented{display:inline-flex;background:#ecebe5;border:1px solid var(--line);border-radius:10px;padding:3px;gap:2px}
.segmented button{border:none;background:transparent;color:var(--muted);font:inherit;font-size:12px;font-weight:600;padding:6px 11px;border-radius:8px;cursor:pointer}
.segmented button.on{background:#fff;color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08)}
#genInfo{font-size:12.5px;color:var(--muted);margin:10px 0 18px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:12px;margin-bottom:14px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:15px 16px;box-shadow:var(--shadow)}
.kpi .lbl{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700}
.kpi .val{font-size:27px;font-weight:750;letter-spacing:-.03em;margin-top:7px;line-height:1.05}
.kpi .foot{font-size:11.5px;color:var(--faint);margin-top:6px}
.grid{display:grid;grid-template-columns:1.5fr 1fr;gap:14px;margin-bottom:14px}
.grid>*{min-width:0}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);margin-bottom:14px;overflow:hidden;min-width:0}
.grid .panel{margin-bottom:0}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px 0}
.panel-head h3{font-size:13.5px;font-weight:700;letter-spacing:-.01em}
.panel-head .hint{font-size:11.5px;color:var(--faint)}
.panel-body{padding:14px 18px 18px}
.bars{display:flex;align-items:flex-end;gap:6px;height:132px;padding-top:6px}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;min-width:0}
.bar-track{width:100%;height:104px;display:flex;align-items:flex-end;background:transparent}
.bar{width:100%;border-radius:5px 5px 3px 3px;background:linear-gradient(180deg,#5b8bff,#2f6bff);min-height:3px;transition:.2s}
.bar:hover{filter:brightness(1.08)}
.bar-lbl{font-size:9.5px;color:var(--faint);white-space:nowrap}
.catrow{display:grid;grid-template-columns:132px 1fr 30px;align-items:center;gap:10px;margin-bottom:9px;font-size:12px}
.catrow .nm{color:var(--ink-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.catrow .track{height:7px;background:#f0efe9;border-radius:99px;overflow:hidden}
.catrow .fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#2f6bff,#7aa0ff)}
.catrow .ct{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}
.table-wrap{overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch}
table.table{width:100%;border-collapse:collapse;font-size:12.5px}
table.table th{text-align:left;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);font-weight:700;padding:11px 18px;border-bottom:1px solid var(--line);white-space:nowrap}
table.table td{padding:12px 18px;border-bottom:1px solid #f1efe9;vertical-align:middle}
table.table tr:last-child td{border-bottom:none}
table.table tbody tr:hover{background:#fcfcfa}
table.table .num{text-align:right;font-variant-numeric:tabular-nums}
.acc-name{display:flex;align-items:center;gap:7px;font-weight:650;font-size:13px;white-space:nowrap}
.acc-link{font-size:11px;color:var(--faint);margin-top:2px}
.dot.ok{background:var(--ok);box-shadow:0 0 0 3px var(--ok-soft)}
.dot.bad{background:var(--bad);box-shadow:0 0 0 3px var(--bad-soft)}
.chips{display:flex;gap:4px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;font-weight:600;padding:3px 7px;border-radius:99px;background:#f2f1ec;color:var(--muted);border:1px solid #e8e6df;white-space:nowrap}
.chip.ok{background:var(--ok-soft);color:var(--ok);border-color:#cdeade}
.chip.bad{background:var(--bad-soft);color:var(--bad);border-color:#f3d2d2}
.dot{width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block}

/* account panel */
.account-panel{margin-top:4px}
.account-panel .panel-head{padding-bottom:4px}
.account-panel h2{font-size:19px;font-weight:750;letter-spacing:-.02em}
.account-panel .sub{color:var(--muted);font-size:12px;margin-top:3px}
.tabs{display:flex;gap:4px;padding:12px 18px 0}
.tab{border:none;background:transparent;font:inherit;font-size:12.5px;font-weight:600;color:var(--muted);padding:8px 12px;border-radius:9px;cursor:pointer}
.tab:hover{background:#f3f2ed;color:var(--ink-2)}
.tab.is-active{background:var(--ink);color:#fff}
#tab-videos,#tab-prompts{padding:14px 18px 18px}
.vitem{display:flex;align-items:center;gap:14px;border:1px solid var(--line);border-radius:12px;padding:11px 13px;margin-bottom:8px;transition:.15s}
.vitem:hover{border-color:var(--line-2);background:#fcfcfa}
.vitem .meta{flex:1;min-width:0}
.vitem .t{font-weight:600;font-size:13px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.vitem .d{font-size:11.5px;color:var(--muted);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.vitem .acts{display:flex;gap:6px;flex-shrink:0}
.pill{display:inline-flex;align-items:center;font-size:10px;font-weight:700;padding:2px 8px;border-radius:99px;background:#f2f1ec;color:var(--muted);text-transform:capitalize;letter-spacing:.02em}
.pill.ok{background:var(--ok-soft);color:var(--ok)}
.pill.bad{background:var(--bad-soft);color:var(--bad)}
.cat-item{border:1px solid var(--line);border-radius:12px;margin-bottom:8px;overflow:hidden;background:#fff}
.cat-item>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:8px;padding:12px 14px;font-size:13px;user-select:none}
.cat-item>summary::-webkit-details-marker{display:none}
.cat-item>summary:hover{background:#fcfcfa}
.cat-item>summary strong{font-weight:650}
.cat-item>summary:after{content:"";margin-left:auto;width:7px;height:7px;border-right:1.5px solid var(--faint);border-bottom:1.5px solid var(--faint);transform:rotate(45deg);transition:.15s;flex-shrink:0}
.cat-item[open]>summary:after{transform:rotate(-135deg)}
.cat-item .body{padding:2px 14px 14px}
.cat-item textarea{width:100%;min-height:96px;font-family:ui-monospace,'SFMono-Regular',Menlo,monospace;font-size:12px;line-height:1.5;background:#fbfbf8;border:1px solid var(--line-2);border-radius:10px;padding:9px 10px;color:var(--ink)}
.cat-item textarea:focus{outline:none;border-color:#b9c8ee;box-shadow:0 0 0 3px var(--accent-soft)}
.cat-item .row{margin-top:9px}

/* forms / buttons */
input,select,textarea{font-family:inherit}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line-2);background:#fff;color:var(--ink);padding:9px 13px;border-radius:10px;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer;transition:.15s;text-decoration:none}
.btn:hover{background:#fbfbf8;border-color:#c9c5b9}
.btn-primary{background:var(--ink);border-color:var(--ink);color:#fff}
.btn-primary:hover{background:#000;border-color:#000}
.btn-danger{background:#fff;border-color:#eccaca;color:var(--bad)}
.btn-danger:hover{background:var(--bad-soft)}
.btn-sm{padding:6px 10px;font-size:11.5px;border-radius:8px}
.spinner{width:13px;height:13px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;display:inline-block;animation:spin .7s linear infinite;vertical-align:-2px}
@keyframes spin{to{transform:rotate(360deg)}}
.empty{color:var(--faint);font-size:12.5px;padding:18px 0;text-align:center}
.muted{color:var(--muted)}
.grow{flex:1}
.mt{margin-top:8px}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

/* toast + modal */
.toast{position:fixed;bottom:22px;right:22px;background:var(--ink);color:#fff;padding:12px 16px;border-radius:12px;font-size:12.5px;font-weight:500;box-shadow:0 18px 40px -18px rgba(0,0,0,.55);opacity:0;transform:translateY(8px);transition:.25s;pointer-events:none;z-index:80;max-width:360px}
.toast.err{background:#b42318}
.toast.show{opacity:1;transform:translateY(0)}
.overlay{position:fixed;inset:0;background:rgba(17,19,23,.45);backdrop-filter:blur(3px);display:none;align-items:center;justify-content:center;z-index:60;padding:16px}
.overlay.show{display:flex}
.modal{background:#fff;border-radius:18px;width:440px;max-width:100%;padding:22px;box-shadow:0 30px 70px -30px rgba(0,0,0,.55)}
.modal h3{font-size:16px;font-weight:700;letter-spacing:-.02em;margin-bottom:14px}
.modal label{display:block;font-size:11.5px;font-weight:600;color:var(--muted);margin-bottom:5px}
.modal input,.modal textarea{width:100%;background:#fff;border:1px solid var(--line-2);border-radius:10px;padding:9px 11px;font-size:13px;color:var(--ink)}
.modal input:focus,.modal textarea:focus{outline:none;border-color:#b9c8ee;box-shadow:0 0 0 3px var(--accent-soft)}
.modal textarea{min-height:110px;font-family:ui-monospace,Menlo,monospace;font-size:12px}
.modal .row{margin-top:16px}
.skeleton{background:linear-gradient(90deg,#eeede7 25%,#f7f6f2 37%,#eeede7 63%);background-size:400% 100%;animation:shimmer 1.3s infinite;border-radius:8px;color:transparent!important}
@keyframes shimmer{0%{background-position:100% 0}100%{background-position:0 0}}

@media (max-width:1100px){.grid{grid-template-columns:1fr}}
@media (max-width:900px){
  .app{grid-template-columns:1fr}
  .sidebar{position:static;height:auto;max-height:none}
  .main{padding:20px 16px 48px}
  .account-list{flex-direction:row;overflow-x:auto;padding-bottom:4px}
  .acc{min-width:190px}
  .kpis{grid-template-columns:repeat(2,1fr)}
  .topbar h1{font-size:22px}
  table.table th,table.table td{padding:10px 12px}
}
@media (max-width:520px){
  .kpis{grid-template-columns:1fr 1fr;gap:9px}
  .kpi .val{font-size:22px}
  .topbar-actions{width:100%;justify-content:space-between}
  .segmented{flex:0 0 auto}
  .vitem{flex-wrap:wrap}
  .vitem .acts{width:100%;justify-content:flex-end}
}
@media (hover:none){.acc .acts{opacity:0}.acc.active .acts{opacity:1}}
@media (max-width:640px){
  table.table th:nth-child(3),table.table td:nth-child(3),
  table.table th:nth-child(5),table.table td:nth-child(5),
  table.table th:nth-child(6),table.table td:nth-child(6),
  table.table th:nth-child(7),table.table td:nth-child(7){display:none}
  .table-wrap{overflow:visible}
  table.table thead{display:none}
  table.table,table.table tbody{display:block}
  table.table tr{display:grid;grid-template-columns:repeat(3,1fr);gap:10px 10px;padding:13px 14px;border-bottom:1px solid var(--line)}
  table.table tbody tr:hover{background:transparent}
  table.table td{display:block;border:none;padding:0;text-align:left!important}
  table.table td:nth-child(1),table.table td:nth-child(2){grid-column:1/-1}
  table.table td[data-label]:before{content:attr(data-label);display:block;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin-bottom:3px;font-weight:700}
}
@media (max-width:520px){
  .kpi:last-child{grid-column:span 2}
  .panel-head{flex-wrap:wrap}
  .panel-head .hint{flex-basis:100%}
  .panel-head h3{white-space:nowrap}
}
</style>
</head>
<body>
<div class="app">
  <!-- ============ sidebar ============ -->
  <aside class="sidebar">
    <div class="brand">
      <div class="mark">1</div>
      <div>
        <div class="name">1section</div>
        <div class="tag">Marketing</div>
      </div>
    </div>

    <div class="side-head">
      <span>Accounts</span>
      <button class="icon-btn" title="Add Buffer account" onclick="openAddAccount()">+</button>
    </div>
    <div id="accountList" class="account-list"></div>
    <div style="padding:10px 16px 18px">
      <button class="side-btn" onclick="openAddAccount()">+ Add Buffer account</button>
    </div>

    <details class="side-block" open>
      <summary>General settings</summary>
      <div class="body">
        <label class="field"><span>Videos per day</span><input type="number" id="set_vpd" min="0" max="24"></label>
        <span class="field"><span>Scheduling window</span>
          <div class="row2"><input type="time" id="set_ws"><input type="time" id="set_we"></div>
        </span>
        <label class="field"><span>Timezone</span><input type="text" id="set_tz"></label>
        <div class="muted" id="set_sched" style="margin:2px 0 10px"></div>
        <button class="side-btn" onclick="saveSettings()">Save settings</button>
      </div>
    </details>

    <details class="side-block">
      <summary>Categories</summary>
      <div class="body">
        <div id="categoryList"></div>
        <button class="side-btn" onclick="openAddCategory()">+ Add category</button>
      </div>
    </details>

    <details class="side-block">
      <summary>Music library</summary>
      <div class="body">
        <label class="field"><span>Upload BGM tracks</span><input type="file" id="music_file" accept="audio/*" multiple></label>
        <button class="side-btn" onclick="uploadMusic()">Upload</button>
        <div id="musicList" style="margin-top:10px"></div>
      </div>
    </details>
  </aside>

  <!-- ============ main ============ -->
  <main class="main">
    <header class="topbar">
      <div>
        <h1>Overview</h1>
        <p class="sub">Performance across your Buffer channels</p>
      </div>
      <div class="topbar-actions">
        <div class="segmented" id="rangePicker">
          <button data-days="7" onclick="setRange(7)">7d</button>
          <button data-days="30" class="on" onclick="setRange(30)">30d</button>
          <button data-days="90" onclick="setRange(90)">90d</button>
        </div>
        <button class="btn btn-primary" id="genNowBtn" onclick="generateNow()">▶ Generate post</button>
      </div>
    </header>
    <p id="genInfo">Runs the next account/category in rotation → AI copy → render → post to Buffer</p>

    <section class="kpis" id="kpiRow">
      <div class="kpi"><div class="lbl">Views</div><div class="val skeleton">0000</div><div class="foot">&nbsp;</div></div>
      <div class="kpi"><div class="lbl">Reactions</div><div class="val skeleton">0000</div><div class="foot">&nbsp;</div></div>
      <div class="kpi"><div class="lbl">Engagement</div><div class="val skeleton">0.00%</div><div class="foot">&nbsp;</div></div>
      <div class="kpi"><div class="lbl">Buffer posts</div><div class="val skeleton">0000</div><div class="foot">&nbsp;</div></div>
      <div class="kpi"><div class="lbl">Success rate</div><div class="val skeleton">00%</div><div class="foot">&nbsp;</div></div>
    </section>

    <div class="grid">
      <section class="panel">
        <div class="panel-head"><h3>Activity</h3><span class="hint">last 14 days</span></div>
        <div class="panel-body"><div class="bars" id="activityChart"></div></div>
      </section>
      <section class="panel">
        <div class="panel-head"><h3>Category mix</h3><span class="hint">generated videos</span></div>
        <div class="panel-body" id="categoryChart"></div>
      </section>
    </div>

    <section class="panel">
      <div class="panel-head">
        <h3>Channel performance</h3>
        <span class="hint" id="analyticsUpdated">loading…</span>
      </div>
      <div class="table-wrap"><table class="table" id="accountTable"></table></div>
    </section>

    <section class="panel account-panel" id="accountPanel" style="display:none">
      <div class="panel-head">
        <div>
          <h2 id="panelTitle">Select an account</h2>
          <p class="sub" id="panelSub">Choose a Buffer account to manage its categories, prompts &amp; videos.</p>
        </div>
      </div>
      <div class="tabs">
        <button class="tab is-active" id="tabBtn-videos" onclick="switchTab('videos')">Videos</button>
        <button class="tab" id="tabBtn-prompts" onclick="switchTab('prompts')">Categories &amp; prompts</button>
      </div>
      <div id="tab-videos"><div id="videoList"></div></div>
      <div id="tab-prompts" style="display:none"><div id="accountCats"></div></div>
    </section>
  </main>
</div>

<!-- Add/Edit Account modal -->
<div class="overlay" id="accModal">
  <div class="modal">
    <h3 id="accModalTitle">Add Buffer account</h3>
    <label>Account name</label><input type="text" id="acc_name" placeholder="e.g. 1section.finance">
    <div class="mt"><label>Buffer API token</label><input type="text" id="acc_token" placeholder="buffer access token"></div>
    <div class="mt"><label>Link (shown in video footer)</label><input type="text" id="acc_link" placeholder="e.g. finance.1section.com"></div>
    <div class="row"><button class="btn btn-primary grow" onclick="saveAccount()">Save</button><button class="btn" onclick="closeAccModal()">Cancel</button></div>
  </div>
</div>

<!-- Add/Edit Category modal -->
<div class="overlay" id="catModal">
  <div class="modal">
    <h3>Add category</h3>
    <label>Category name</label><input type="text" id="cat_name" placeholder="e.g. story, stat, tips">
    <div class="mt"><label>Default AI prompt (optional)</label><textarea id="cat_prompt"></textarea></div>
    <div class="row"><button class="btn btn-primary grow" onclick="saveCategory()">Save</button><button class="btn" onclick="closeCatModal()">Cancel</button></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const state = { accounts: [], categories: [], selectedId: null };
let accountCats = [];
let musicFiles = [];
let analyticsDays = 30;

function toast(msg, err) { const t = document.getElementById('toast'); t.textContent = msg; t.className = 'toast' + (err ? ' err' : '') + ' show'; setTimeout(() => t.classList.remove('show'), 3200); }
async function api(path, opts) { const r = await fetch(path, Object.assign({ headers: { 'Content-Type': 'application/json' } }, opts)); const j = await r.json().catch(() => ({})); if (!r.ok) throw new Error(j.error || r.statusText); return j; }

async function refreshAll() {
  state.accounts = await api('/api/accounts');
  state.categories = await api('/api/categories');
  renderAccounts(); renderCategories(); renderSettings(); renderPanel(); renderMusic();
  renderAnalytics();
}

/* ---------------- analytics ---------------- */
const nfCompact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
const nfFull = new Intl.NumberFormat('en');
function fmtN(n) { n = Number(n) || 0; return n >= 10000 ? nfCompact.format(n) : nfFull.format(n); }
function relTime(v) {
  if (!v) return '—';
  const iso = String(v).includes('T') ? v : String(v).replace(' ', 'T') + 'Z';
  const diff = Date.now() - new Date(iso).getTime();
  if (!Number.isFinite(diff)) return '—';
  const m = Math.round(diff / 60000);
  if (m < 1) return 'just now';
  if (m < 60) return m + 'm ago';
  const h = Math.round(m / 60);
  if (h < 24) return h + 'h ago';
  const d = Math.round(h / 24);
  if (d < 30) return d + 'd ago';
  return new Date(iso).toLocaleDateString();
}

function setRange(days) {
  analyticsDays = days;
  document.querySelectorAll('#rangePicker button').forEach(b => b.classList.toggle('on', Number(b.dataset.days) === days));
  renderAnalytics();
}

async function renderAnalytics() {
  try {
    const d = await api('/api/analytics?days=' + analyticsDays);
    renderKpis(d);
    renderActivity(d.daily || []);
    renderCategoryChart(d.categories || []);
    renderAccountTable(d.accounts || []);
    const when = new Date(d.updatedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    document.getElementById('analyticsUpdated').textContent = `${d.online}/${d.totalAccounts} connected · updated ${when}`;
  } catch (e) {
    document.getElementById('analyticsUpdated').textContent = 'analytics unavailable: ' + e.message;
  }
}

function renderKpis(d) {
  const t = d.totals || {};
  const items = [
    { lbl: 'Views', val: fmtN(t.views), foot: `${d.online}/${d.totalAccounts} channels connected` },
    { lbl: 'Reactions', val: fmtN(t.reactions), foot: 'likes · saves · shares' },
    { lbl: 'Engagement', val: (Number(t.engagementRate) || 0).toFixed(2) + '%', foot: 'reactions ÷ views' },
    { lbl: 'Buffer posts', val: fmtN(t.posts), foot: `last ${d.range.days} days` },
    { lbl: 'Success rate', val: (Number(t.successRate) || 0).toFixed(1) + '%', foot: `${fmtN(t.success)} of ${fmtN(t.generated)} generated` },
  ];
  document.getElementById('kpiRow').innerHTML = items.map(i => `
    <div class="kpi"><div class="lbl">${i.lbl}</div><div class="val">${i.val}</div><div class="foot">${i.foot}</div></div>`).join('');
}

function renderActivity(daily) {
  const el = document.getElementById('activityChart');
  if (!daily.length) { el.innerHTML = '<div class="empty">No activity yet</div>'; return; }
  const max = Math.max(1, ...daily.map(d => d.count));
  el.innerHTML = daily.map(d => {
    const dt = new Date(d.date + 'T12:00:00');
    const lbl = dt.toLocaleDateString([], { weekday: 'short' }).slice(0, 2);
    const h = Math.round((d.count / max) * 100);
    return `<div class="bar-col" title="${d.date}: ${d.count} video(s)">
      <div class="bar-track"><div class="bar" style="height:${Math.max(3, h)}%"></div></div>
      <div class="bar-lbl">${lbl}</div>
    </div>`;
  }).join('');
}

function renderCategoryChart(cats) {
  const el = document.getElementById('categoryChart');
  if (!cats.length) { el.innerHTML = '<div class="empty">No videos yet</div>'; return; }
  const max = Math.max(1, ...cats.map(c => c.count));
  el.innerHTML = cats.map(c => `
    <div class="catrow">
      <div class="nm" title="${escapeHtml(c.name)}">${escapeHtml(c.name)}</div>
      <div class="track"><div class="fill" style="width:${Math.round((c.count / max) * 100)}%"></div></div>
      <div class="ct">${c.count}</div>
    </div>`).join('');
}

function channelChips(channels) {
  if (!channels || !channels.length) return '<span class="chip">not connected</span>';
  const short = { instagram: 'Instagram', tiktok: 'TikTok', youtube: 'YouTube', twitter: 'X', linkedin: 'LinkedIn', facebook: 'Facebook', threads: 'Threads', bluesky: 'Bluesky', mastodon: 'Mastodon', pinterest: 'Pinterest' };
  return channels.map(c => `<span class="chip">${escapeHtml(short[c.service] || c.service)}</span>`).join('');
}

function renderAccountTable(accounts) {
  const table = document.getElementById('accountTable');
  if (!accounts.length) { table.innerHTML = '<tbody><tr><td><div class="empty">No Buffer accounts yet</div></td></tr></tbody>'; return; }
  const head = `<thead><tr>
    <th>Account</th><th>Channels</th><th class="num">Posts</th><th class="num">Views</th>
    <th class="num">Reactions</th><th class="num">Eng.</th><th class="num">Generated</th>
    <th class="num">Success</th><th>Last post</th>
  </tr></thead>`;
  const rows = accounts.map(a => {
    const rate = a.local.generated ? Math.round((a.local.success / a.local.generated) * 100) : 0;
    const status = a.ok
      ? '<span class="dot ok" title="connected"></span>'
      : `<span class="dot bad" title="${escapeHtml(a.error || 'offline')}"></span>`;
    return `<tr data-account="${a.account_id}" style="cursor:pointer">
      <td><div class="acc-name">${status}${escapeHtml(a.account)}</div><div class="acc-link">${escapeHtml(a.link || '')}</div></td>
      <td><div class="chips">${channelChips(a.channels)}</div></td>
      <td class="num" data-label="Posts">${fmtN(a.metrics.posts)}</td>
      <td class="num" data-label="Views">${fmtN(a.metrics.views)}</td>
      <td class="num" data-label="Reactions">${fmtN(a.metrics.reactions)}</td>
      <td class="num" data-label="Eng.">${(Number(a.metrics.engagementRate) || 0).toFixed(2)}%</td>
      <td class="num" data-label="Generated">${fmtN(a.local.generated)}</td>
      <td class="num" data-label="Success">${rate}%</td>
      <td style="white-space:nowrap" data-label="Last post">${relTime(a.local.lastAt)}</td>
    </tr>`;
  }).join('');
  table.innerHTML = head + '<tbody>' + rows + '</tbody>';
  table.querySelectorAll('tr[data-account]').forEach(tr => {
    tr.onclick = () => { state.selectedId = Number(tr.dataset.account); renderAccounts(); renderPanel(); scrollToPanel(); };
  });
}

/* ---------------- accounts ---------------- */
function renderAccounts() {
  const el = document.getElementById('accountList');
  el.innerHTML = state.accounts.length ? '' : '<div class="empty" style="padding:8px 4px">No accounts yet</div>';
  state.accounts.forEach(a => {
    const d = document.createElement('div');
    d.className = 'acc' + (a.id === state.selectedId ? ' active' : '');
    d.innerHTML = `<div><div class="name">${escapeHtml(a.name)}</div><span class="sub">${escapeHtml(a.link || 'no link set')}</span></div><div class="acts"><button class="btn-sm" title="Edit">Edit</button><button class="del" title="Delete">✕</button></div>`;
    d.onclick = (e) => { if (e.target.closest('button')) return; state.selectedId = a.id; renderAccounts(); renderPanel(); scrollToPanel(); };
    d.querySelector('button.btn-sm').onclick = (e) => { e.stopPropagation(); openEditAccount(a); };
    d.querySelector('.del').onclick = async (e) => { e.stopPropagation(); if (!confirm('Delete account?')) return; await api('/api/accounts/' + a.id, { method: 'DELETE' }); state.selectedId = null; refreshAll(); };
    el.appendChild(d);
  });
}

/* ---------------- categories ---------------- */
function renderCategories() {
  const el = document.getElementById('categoryList');
  el.innerHTML = state.categories.length ? '' : '<div class="empty" style="padding:8px 4px">No categories yet</div>';
  state.categories.forEach(c => {
    const d = document.createElement('div');
    d.className = 'cat-mini';
    d.innerHTML = `<span>${escapeHtml(c.name)}</span><button class="x" title="Delete">✕</button>`;
    d.onclick = (e) => { if (e.target.classList.contains('x')) return; openEditCategory(c); };
    d.querySelector('.x').onclick = async (e) => { e.stopPropagation(); if (!confirm('Delete category?')) return; await api('/api/categories/' + c.id, { method: 'DELETE' }); refreshAll(); };
    el.appendChild(d);
  });
}

/* ---------------- account panel ---------------- */
function switchTab(name) {
  ['videos', 'prompts'].forEach(t => {
    document.getElementById('tab-' + t).style.display = t === name ? 'block' : 'none';
    document.getElementById('tabBtn-' + t).classList.toggle('is-active', t === name);
  });
}

function scrollToPanel() {
  setTimeout(() => {
    const el = document.getElementById('accountPanel');
    if (el && el.style.display !== 'none') el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 400);
}

async function renderPanel() {
  const panel = document.getElementById('accountPanel');
  if (!state.selectedId) {
    panel.style.display = 'none';
    document.getElementById('panelTitle').textContent = 'Select an account';
    document.getElementById('panelSub').textContent = 'Choose a Buffer account to manage its categories, prompts & videos.';
    return;
  }
  const acc = state.accounts.find(a => a.id === state.selectedId);
  panel.style.display = 'block';
  document.getElementById('panelTitle').textContent = acc ? acc.name : '';
  document.getElementById('panelSub').textContent = acc && acc.link ? acc.link : 'Manage categories, AI prompts and videos.';

  accountCats = await api('/api/accounts/' + state.selectedId + '/categories');
  renderAccountCats();
  renderVideos();
}

function availableCatIds() { return state.categories.map(c => c.id); }

function renderAccountCats() {
  const el = document.getElementById('accountCats');
  if (!state.categories.length) { el.innerHTML = '<div class="empty">Add categories first</div>'; return; }
  el.innerHTML = '';
  const defaultPromptFor = (categoryId) => {
    const c = state.categories.find(x => x.id === categoryId);
    return c ? (c.default_prompt || '') : '';
  };
  const mapped = accountCats.map(ac => ac.category_id);
  const rows = [];
  accountCats.forEach(ac => rows.push({ id: ac.category_id, name: ac.category_name, prompt: ac.prompt != null ? ac.prompt : '', mapped: true }));
  state.categories.filter(c => !mapped.includes(c.id)).forEach(c => rows.push({ id: c.id, name: c.name, prompt: defaultPromptFor(c.id), mapped: false }));

  if (!rows.length) { el.innerHTML = '<div class="empty">No categories</div>'; return; }

  rows.forEach(r => {
    const d = document.createElement('details');
    d.className = 'cat-item';
    d.innerHTML = `
      <summary>
        <strong>${escapeHtml(r.name)}</strong>
        ${r.mapped ? '' : '<span class="pill">not mapped</span>'}
      </summary>
      <div class="body">
        <textarea placeholder="Per-account AI prompt for ${escapeHtml(r.name)}">${escapeHtml(r.prompt || '')}</textarea>
        <div class="row mt">
          <button class="btn btn-sm btn-primary" onclick="savePrompt(${r.id}, this)">Save prompt</button>
          ${r.mapped ? `<button class="btn btn-sm btn-danger" onclick="removePrompt(${r.id})">Remove from account</button>` : ''}
        </div>
      </div>`;
    el.appendChild(d);
  });
}

async function savePrompt(categoryId, btn) {
  const textarea = btn.closest('.cat-item').querySelector('textarea');
  await api(`/api/accounts/${state.selectedId}/categories/${categoryId}/prompt`, { method: 'PUT', body: JSON.stringify({ prompt: textarea.value }) });
  toast('Prompt saved');
  accountCats = await api('/api/accounts/' + state.selectedId + '/categories');
  renderAccountCats();
}

async function removePrompt(categoryId) {
  accountCats = accountCats.filter(x => x.category_id !== categoryId);
  await api('/api/accounts/' + state.selectedId + '/categories', { method: 'PUT', body: JSON.stringify({ pairs: accountCats.map((x, i) => ({ category_id: x.category_id, prompt: x.prompt, position: i })) }) });
  renderPanel();
}

async function renderVideos() {
  const el = document.getElementById('videoList');
  const videos = await api('/api/videos?account_id=' + state.selectedId);
  if (!videos.length) { el.innerHTML = '<div class="empty">No videos for this account yet</div>'; return; }
  el.innerHTML = '';
  videos.forEach(v => {
    const d = document.createElement('div');
    d.className = 'vitem';
    d.dataset.id = v.id;
    const st = v.status === 'success' ? 'pill ok' : v.status === 'failed' ? 'pill bad' : 'pill';
    const viewHref = v.video_path ? '/videos/' + v.video_path.split('/').pop() : null;
    d.innerHTML = `
      <div class="meta">
        <div class="t">#${v.id} · ${escapeHtml(v.category_name || '')} <span class="${st}">${v.status}</span>${v.attempts > 1 ? `<span class="muted" style="font-size:11px">${v.attempts}× attempts</span>` : ''}</div>
        <div class="d">${escapeHtml((v.caption || '').slice(0, 110)) || '—'}</div>
        ${v.last_error ? `<div class="d" style="color:var(--bad)">${escapeHtml(v.last_error)}</div>` : ''}
      </div>
      <div class="acts">
        ${viewHref ? `<a class="btn btn-sm" href="${viewHref}" target="_blank">View</a>` : ''}
        ${v.status !== 'success' ? `<button class="btn btn-sm btn-primary" onclick="retry(${v.id})">Retry</button>` : ''}
        <button class="btn btn-sm btn-danger" onclick="delVideo(${v.id})">Delete</button>
      </div>`;
    el.appendChild(d);
  });
}

async function retry(id) { await api('/api/videos/' + id + '/retry', { method: 'POST' }); toast('Retry done'); renderVideos(); }
async function delVideo(id) { if (!confirm('Delete video?')) return; await api('/api/videos/' + id, { method: 'DELETE' }); renderVideos(); }

async function generateNow() {
  const btn = document.getElementById('genNowBtn');
  const info = document.getElementById('genInfo');
  btn.disabled = true;
  const original = btn.textContent;
  btn.innerHTML = '<span class="spinner"></span> Generating… (~1 min)';
  info.textContent = 'AI copy → render video → post to Buffer. Working, please wait…';
  try {
    const r = await api('/api/generate', { method: 'POST' });
    const v = r.video;
    if (v && v.status === 'success') {
      toast('Video generated & posted!');
      info.textContent = 'Done → video #' + v.id + ' posted.';
    } else if (v && v.status === 'failed') {
      toast('Video generated but upload failed', true);
      info.textContent = 'Video generated, upload failed: ' + (v.last_error || '').slice(0, 160);
    } else if (v && v.status === 'pending') {
      toast('Video generated', true);
      info.textContent = 'Generated, but still pending: ' + (r.result?.error || '').slice(0, 160);
    } else if (r.result?.error) {
      toast(r.result.error, true);
      info.textContent = 'Failed: ' + r.result.error;
    } else {
      toast('Done');
      info.textContent = 'Done';
    }
    if (v && v.account_id) {
      state.selectedId = v.account_id;
      await refreshAll();
      renderVideos();
      scrollToVideo(v.id);
    } else {
      await refreshAll();
    }
  } catch (e) {
    toast(e.message, true);
    info.textContent = 'Failed: ' + e.message;
  } finally {
    btn.disabled = false;
    btn.textContent = original;
  }
}

function scrollToVideo(id) {
  setTimeout(() => {
    const item = document.querySelector('.vitem[data-id="' + id + '"]');
    if (item) {
      item.style.outline = '2px solid var(--accent)';
      item.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => { item.style.outline = ''; }, 2500);
    }
  }, 200);
}

/* ---------------- settings ---------------- */
function renderSettings() {
  api('/api/settings').then(s => {
    document.getElementById('set_vpd').value = s.videos_per_day;
    document.getElementById('set_ws').value = s.window_start;
    document.getElementById('set_we').value = s.window_end;
    document.getElementById('set_tz').value = s.tz;
    const slots = s.schedules || [];
    document.getElementById('set_sched').textContent =
      `${s.videos_per_day} posts/day · ${s.window_start}–${s.window_end}` + (slots.length ? '' : ' · disabled');
  });
}

async function saveSettings() {
  await api('/api/settings', {
    method: 'PUT', body: JSON.stringify({
      videos_per_day: document.getElementById('set_vpd').value,
      window_start: document.getElementById('set_ws').value,
      window_end: document.getElementById('set_we').value,
      tz: document.getElementById('set_tz').value,
    })
  });
  toast('Settings saved');
  renderSettings();
}

/* ---------------- account modal ---------------- */
function openAddAccount() { document.getElementById('acc_name').value = ''; document.getElementById('acc_token').value = ''; document.getElementById('acc_link').value = ''; window.__editAcc = null; document.getElementById('accModalTitle').textContent = 'Add Buffer account'; document.getElementById('accModal').classList.add('show'); }
async function openEditAccount(a) { const acc = await api('/api/accounts/' + a.id); document.getElementById('acc_name').value = acc.name; document.getElementById('acc_token').value = acc.buffer_token || ''; document.getElementById('acc_link').value = acc.link || ''; window.__editAcc = a.id; document.getElementById('accModalTitle').textContent = 'Edit Buffer account'; document.getElementById('accModal').classList.add('show'); }
function closeAccModal() { document.getElementById('accModal').classList.remove('show'); }
async function saveAccount() {
  const name = document.getElementById('acc_name').value.trim();
  const token = document.getElementById('acc_token').value.trim();
  const link = document.getElementById('acc_link').value.trim();
  if (!name || !token) return toast('Fill all fields', true);
  const editId = window.__editAcc;
  try {
    if (editId != null) { await api('/api/accounts/' + editId, { method: 'PUT', body: JSON.stringify({ name, buffer_token: token, link }) }); }
    else { await api('/api/accounts', { method: 'POST', body: JSON.stringify({ name, buffer_token: token, link }) }); }
    closeAccModal(); refreshAll();
  } catch (e) { toast(e.message, true); }
}
document.getElementById('accModal').onclick = (e) => { if (e.target.id === 'accModal') closeAccModal(); };

/* ---------------- category modal ---------------- */
function openAddCategory() { document.getElementById('cat_name').value = ''; document.getElementById('cat_prompt').value = ''; window.__editCat = null; document.getElementById('catModal').classList.add('show'); }
function closeCatModal() { document.getElementById('catModal').classList.remove('show'); }
async function saveCategory() {
  const name = document.getElementById('cat_name').value.trim();
  const prompt = document.getElementById('cat_prompt').value;
  if (!name) return toast('Category name required', true);
  const editId = window.__editCat;
  if (editId != null) {
    await api('/api/categories/' + editId, { method: 'PUT', body: JSON.stringify({ name, default_prompt: prompt }) });
    delete window.__editCat;
  } else {
    await api('/api/categories', { method: 'POST', body: JSON.stringify({ name, default_prompt: prompt }) });
  }
  closeCatModal(); refreshAll();
}
function openEditCategory(c) { document.getElementById('cat_name').value = c.name; document.getElementById('cat_prompt').value = c.default_prompt || ''; document.getElementById('catModal').classList.add('show'); window.__editCat = c.id; }
document.getElementById('catModal').onclick = (e) => { if (e.target.id === 'catModal') closeCatModal(); };

/* ---------------- music ---------------- */
function fmtDur(s) { if (s == null) return '—'; const m = Math.floor(s / 60); const ss = Math.round(s % 60); return `${m}:${String(ss).padStart(2, '0')}`; }

async function renderMusic() {
  const el = document.getElementById('musicList');
  try { musicFiles = await api('/api/music'); } catch (e) { el.innerHTML = '<div class="muted">Load failed</div>'; return; }
  if (!musicFiles.length) { el.innerHTML = '<div class="muted">No music yet</div>'; return; }
  el.innerHTML = '';
  musicFiles.forEach((f, i) => {
    const d = document.createElement('div');
    d.className = 'music-item';
    d.innerHTML = `
      <div class="nm" title="${escapeHtml(f.name)}">${escapeHtml(f.name)}<div class="sz">${fmtDur(f.duration)} · ${(f.size / 1048576).toFixed(1)} MB</div></div>
      <button title="Preview" onclick="previewMusic(${i})">▶</button>
      <button title="Rename" onclick="renameMusic(${i})">✎</button>
      <button title="Delete" onclick="deleteMusic(${i})">✕</button>
      <audio id="audio-${i}" src="/music/${encodeURIComponent(f.name)}" preload="none"></audio>`;
    el.appendChild(d);
  });
}

function previewMusic(i) {
  const a = document.getElementById('audio-' + i);
  if (!a) return;
  if (a.paused) { document.querySelectorAll('audio').forEach(x => x.pause()); a.play(); }
  else a.pause();
}

async function uploadMusic() {
  const input = document.getElementById('music_file');
  if (!input.files.length) return toast('Choose audio files first', true);
  const fd = new FormData();
  Array.from(input.files).forEach(f => fd.append('files', f));
  try {
    const r = await fetch('/api/music/upload', { method: 'POST', body: fd });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || r.statusText);
    input.value = '';
    toast('Uploaded ' + j.files.length + (j.files.length > 1 ? ' tracks' : ' track'));
    renderMusic();
  } catch (e) { toast(e.message, true); }
}

async function deleteMusic(i) {
  const f = musicFiles[i];
  if (!f || !confirm('Delete "' + f.name + '"?')) return;
  try { await api('/api/music/' + encodeURIComponent(f.name), { method: 'DELETE' }); renderMusic(); }
  catch (e) { toast(e.message, true); }
}

async function renameMusic(i) {
  const f = musicFiles[i];
  if (!f) return;
  const nn = prompt('New file name (keep the extension)', f.name);
  if (!nn || nn === f.name) return;
  try { await api('/api/music/' + encodeURIComponent(f.name), { method: 'PUT', body: JSON.stringify({ name: nn }) }); renderMusic(); }
  catch (e) { toast(e.message, true); }
}

function escapeHtml(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

refreshAll();
</script>
</body>
</html>
