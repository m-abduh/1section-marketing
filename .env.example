OPENROUTER_KEY=sk-your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Buffer token is stored per-account in the DB (not in .env)
TZ=America/New_York
PORT=8000
# PUBLIC_URL=https://your-server.com  (required for Buffer video hosting)
RENDER_CONCURRENCY=1
# Dashboard basic auth (internal login)
DASHBOARD_USER=internal
DASHBOARD_PASSWORD=change-me

