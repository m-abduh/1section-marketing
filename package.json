{
  "name": "marketing-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon server.js",
    "start": "NODE_ENV=production node server.js",
    "seed": "node -e \"import('./db.mjs').then(m=>{m.store.seedCategories();m.store.syncAllAccountCategories();console.log('Seed done ->', m.store.listCategories().map(c=>c.name).join(', '))})\"",
    "seed:accounts": "node seed-accounts.mjs",
    "seed:extra": "node seed-extra-accounts.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "ejs": "^6.0.1",
    "express": "^4.21.2",
    "marked": "^18.0.11",
    "multer": "^2.3.0",
    "node-cron": "^3.0.3",
    "p-limit": "^6.2.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
